# Copy this file to .env and add your real credentials.

TAVILY_API_KEY=your_tavily_api_key_here

# Automatically route tasks to the best available provider, with failover.
LLM_PROVIDER=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Optional speed settings (defaults shown)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=2500
